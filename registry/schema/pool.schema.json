{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ujwalam.local/schema/pool.schema.json",
  "title": "Effect pool",
  "type": "object",
  "required": ["id", "version", "name", "presets", "noRepeatLastN"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "version": { "$ref": "common.schema.json#/$defs/semver" },
    "name": { "type": "string", "minLength": 1 },
    "presets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["preset", "weight"],
        "additionalProperties": false,
        "properties": {
          "preset": { "$ref": "common.schema.json#/$defs/id" },
          "weight": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "noRepeatLastN": { "type": "integer", "minimum": 0 },
    "seed": { "type": "integer" },
    "legacySource": { "type": "string", "pattern": "^legacy/[^\\\\]+$" }
  }
}
