{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ujwalam.local/schema/common.schema.json",
  "title": "Shared definitions",
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "maxLength": 80 },
    "semver": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$" },
    "semverRange": {
      "type": "string",
      "pattern": "^(\\^|~|>=)?(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "canvases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["H", "V"] }
    }
  }
}
