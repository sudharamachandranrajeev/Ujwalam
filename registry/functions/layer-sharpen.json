{
  "id": "layer-sharpen",
  "version": "0.1.0",
  "category": "effects",
  "family": "layer-filters",
  "name": "Layer sharpen",
  "description": "Sharpens a layer (OBS sharpness filter, D291 proposed). amount 0..1.",
