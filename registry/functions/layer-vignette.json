{
  "id": "layer-vignette",
  "version": "0.1.0",
  "category": "effects",
  "family": "layer-filters",
  "name": "Layer vignette",
  "description": "Darkens (or tints) the edges of a layer towards a colour: amount, clear-centre size and softness 0..1 (ujw_vignette.effect, D291 proposed).",
  "params": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect"
      ],
      "properties": {
        "effect": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "amount",
            "size",
            "softness",
            "color"
          ],
          "properties": {
            "type": {
              "const": "vignette"
            },
            "amount": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "size": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "softness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          }
        }
      }
    },
    "defaults": {
      "effect": {
        "type": "vignette",
        "amount": 0.5,
        "size": 0.4,
        "softness": 0.4,
        "color": "#000000"
      }
    },
    "safeRanges": {
      "amount": [
        0,
        1
      ],
      "size": [
        0,
        1
      ],
      "softness": [
        0,
        1
      ]
    }
  },
  "canvases": [
    "H",
    "V"
  ],
  "themeTokens": [],
  "durationMs": 0,
  "maxConcurrent": 0,
  "flashesPerSec": 0,
  "budgetCost": 0,
  "status": "in-progress",
  "format": "native-shader",
  "planSection": "4.2"
}
