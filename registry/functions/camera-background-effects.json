{
  "id": "camera-background-effects",
  "version": "0.2.0",
  "category": "sources-camera-audio",
  "family": "camera",
  "name": "Camera background effects",
  "description": "Background removal, blur or replacement for a camera layer (personMask, ujw_person_mask; flag face-ai, off by default; D295 proposed). The face AI worker (services/face, onnxruntime-directml, MediaPipe selfie segmentation, Apache-2.0) returns a person matte for the camera through the face link (shared memory); the host composites it in a shader: remove (transparent background), blur (the layer blurred behind the person, strength as the blur effect) or replace (a colour, or an image file). threshold and feather shape the matte edge; smoothing is temporal (worker). A stale matte (> 500 ms) fades out over 300 ms to the plain camera; no worker = plain camera. Measured cost and live use: docs/evidence/2026-11-08-face-ai.md; live use needs the user's decision.",
  "params": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect"
      ],
      "properties": {
        "effect": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "threshold",
            "feather",
            "smoothing"
          ],
          "properties": {
            "type": {
              "const": "personMask"
            },
            "mode": {
              "enum": [
                "remove",
                "blur",
                "replace"
              ]
            },
            "threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "feather": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "smoothing": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.95
            },
            "strength": {
              "type": "number",
              "minimum": 1,
              "maximum": 100
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "file": {
              "type": "object",
              "description": "project file ref {base, rel}; chosen when the preset is applied",
              "required": [
                "base",
                "rel"
              ]
            }
          }
        }
      }
    },
    "defaults": {
      "effect": {
        "type": "personMask",
        "mode": "remove",
        "threshold": 0.5,
        "feather": 0.2,
        "smoothing": 0.4
      }
    },
    "safeRanges": {
      "threshold": [
        0.2,
        0.8
      ],
      "feather": [
        0,
        0.5
      ],
      "smoothing": [
        0,
        0.8
      ],
      "strength": [
        5,
        60
      ]
    }
  },
  "canvases": [
    "H",
    "V"
  ],
  "themeTokens": [],
  "durationMs": 0,
  "maxConcurrent": 0,
  "flashesPerSec": 0,
  "budgetCost": 0,
  "status": "in-progress",
  "format": "native-shader",
  "planSection": "4.4"
}
