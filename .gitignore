# media
*.mp4
*.mkv
*.mov
*.flv
*.ts
*.wav
*.m4a
*.webm

# analysis caches
cache/
.cache/
analysis-cache/

# dependencies and build
node_modules/
__pycache__/
.venv/
.venv-gpu/

# logs
*.log
logs/

# local-only and secrets
*.local.*
*.env
.env*
secrets/
**/secrets.local.js
.claude/settings.local.json

# labels are tracked (keep explicit)
!data/labels/
!data/labels/.gitkeep

# Test recordings and spike output (media; kept until the phase gate passes, deleted only with user approval).
out/

# P1 spike build output (generated import lib, obsconfig.h, binaries).
app/spike/build/

# Evidence frames showing the user's face or other players' names. Local only, never committed.
docs/evidence/private/

# Meld session exports (user data: device ids, scene layout). Never committed.
session file/

# Private reference copy; never committed or distributed. Integrity: legacy.manifest.sha256
legacy/

# Live-stream feedback captures (replay clips, logs, voice notes). Local only; triage goes to docs/feedback/.
feedback/

# Agent session lock (docs/procedures/session-protocol.md).
.agent-lock

# Agent git worktrees (separate checkouts of this repo).
.claude/worktrees/

# Local datasets (reference crops can show player names; never committed).
data/datasets/

# Local learning store (LL2/LL5, D338): label rows and stream evidence. Normally in the app data folder; never committed.
learning-store/

# Per-game local data (pack format W0): reference datasets, crops, labels work files, evaluations. Never committed.
data/games/*/local/

# Face AI model files (downloaded and SHA-256 checked by services/face/fetch_models.py; manifest data/models/face-ai.json)
/data/models/face/

# The user's own stream assets (media, faces, brand, Meld sessions with local paths): local only, never committed (2026-11-07)
/data/stream assets/
