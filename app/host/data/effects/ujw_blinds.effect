// SPDX-License-Identifier: GPL-3.0-or-later
// ujwalam-host: ujw_blinds filter (src/effects.cpp, D262). Embedded into the host exe at build time (CMakeLists.txt
// generates ujw_effects.h). Direct3D 11 (libobs-d3d11) only.
// Venetian blinds: the layer is cut into parallel slats `slat` px wide, across direction `dir` (unit vector, y down);
// the first `hide` share of every slat is transparent, with a soft edge `feather` px wide. hide 0 = all shown.

uniform float4x4 ViewProj;
uniform texture2d image;
uniform float2 size;
uniform float2 dir;
uniform float slat;
uniform float hide;
uniform float feather;

sampler_state clampSampler {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = v_in.uv;
	return vert_out;
}

float4 PSBlinds(VertData v_in) : TARGET
{
	float4 rgba = image.Sample(clampSampler, v_in.uv);
	if (hide <= 0.0)
		return rgba;
	float t = dot(v_in.uv * size, dir);
	float f = t - floor(t / slat) * slat; // 0..slat within the slat
	float edge = hide * slat;
	float a = feather > 0.0 ? smoothstep(edge - feather * 0.5, edge + feather * 0.5, f) : step(edge, f);
	if (hide >= 1.0)
		a = 0.0;
	rgba.a *= a;
	return rgba;
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSBlinds(v_in);
	}
}
