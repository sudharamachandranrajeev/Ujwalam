// SPDX-License-Identifier: GPL-3.0-or-later
// ujwalam-host: ujw_posterize (src/effects.cpp "ujw_pass", D291). Embedded into the host exe at build time
// (CMakeLists.txt generates ujw_effects.h). Direct3D 11 (libobs-d3d11) only.
// Posterize: each colour channel rounded to p.x levels (2..32), on the stored values. Alpha is kept.

uniform float4x4 ViewProj;
uniform texture2d image;
uniform float4 p;

sampler_state clampSampler {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = v_in.uv;
	return vert_out;
}

float4 PSPosterize(VertData v_in) : TARGET
{
	float4 rgba = image.Sample(clampSampler, v_in.uv);
	float l = max(p.x, 2.0) - 1.0;
	rgba.rgb = floor(rgba.rgb * l + 0.5) / l;
	return rgba;
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSPosterize(v_in);
	}
}
