{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ujwalam-guide-data",
  "$comment": "Schema for data/guide/tour.json and data/guide/hints.json (D294 proposed). Plain English for new users: no jargon, no names. Anchors are object names the studio window registers (app/studio/src/guide.cpp); a step or hint whose anchor is missing is skipped.",
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
    "anchor": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$" },
    "title": { "type": "string", "minLength": 2, "maxLength": 60 },
    "text": { "type": "string", "minLength": 10, "maxLength": 400 }
  },
  "oneOf": [
    {
      "title": "tour.json",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "tours"],
      "properties": {
        "$comment": { "type": "string" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "tours": {
          "type": "array", "minItems": 1, "maxItems": 10,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "title", "steps"],
            "properties": {
              "id": { "$ref": "#/$defs/slug" },
              "title": { "$ref": "#/$defs/title" },
              "steps": {
                "type": "array", "minItems": 1, "maxItems": 30,
                "items": {
                  "type": "object", "additionalProperties": false, "required": ["id", "anchor", "title", "text"],
                  "properties": {
                    "id": { "$ref": "#/$defs/slug" },
                    "anchor": { "$ref": "#/$defs/anchor" },
                    "title": { "$ref": "#/$defs/title" },
                    "text": { "$ref": "#/$defs/text" },
                    "side": { "enum": ["auto", "left", "right", "above", "below"] }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "title": "hints.json",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "hints"],
      "properties": {
        "$comment": { "type": "string" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "hints": {
          "type": "array", "minItems": 1, "maxItems": 60,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "anchor", "trigger", "title", "text"],
            "properties": {
              "id": { "$ref": "#/$defs/slug" },
              "anchor": { "$ref": "#/$defs/anchor" },
              "trigger": { "enum": ["recording-stopped-ask", "clip-run-started", "match-skipped", "went-live", "layer-with-effects", "first-task"] },
              "title": { "$ref": "#/$defs/title" },
              "text": { "$ref": "#/$defs/text" }
            }
          }
        }
      }
    }
  ]
}
