{
  "$comment": "Template. Copy to data/profile.local.json (gitignored) and fill in. Every string value there is a private term for the git hooks (tools/git-hooks). Placeholders in <angle brackets> are never treated as private terms.",
  "version": "0.1.0",
  "streamer": {
    "name": "<streamer-name>",
    "brand": "<brand>",
    "variants": ["<streamer-variant-1>", "<streamer-variant-2>"]
  },
  "channels": {
    "twitch": "<twitch-channel>",
    "youtube_handle": "<youtube-handle>",
    "youtube_channel_id": "<youtube-channel-id>",
    "kick": "<kick-channel>",
    "discord_invite": "<discord-invite>"
  },
  "games": {
    "codm": {
      "ign": "<ign>",
      "variants": ["<ign-variant-1>", "<ign-variant-2>"],
      "clan_tag": null
    }
  },
  "paths": {
    "clips_corpus": "<clips-corpus>",
    "analysis_cache": "<analysis-cache>",
    "windows_user": "<windows-user>",
    "event_core_data": "<event-core-data>",
    "meld_session": "<meld-session-file>",
    "streamerbot_exe": "<streamerbot-exe>",
    "speakerbot_exe": "<speakerbot-exe>",
    "stream_assets": "<stream-assets-folder-or-remove-for-data/stream assets>"
  },
  "bots": {
    "streamerbot_ws": "<streamerbot-ws-or-remove-for-default>",
    "speakerbot_ws": "<speakerbot-ws-or-remove-for-default>"
  },
  "brand": {
    "wordmark": "<brand-wordmark-file>",
    "character": "<brand-character-file>"
  },
  "handles": {
    "twitch": "<twitch-handle>",
    "youtube": "<youtube-handle>",
    "kick": "<kick-handle>"
  },
  "links": {
    "discord": "<discord-link>",
    "issues_url": "<private-repo-issues-url>"
  },
  "devices": {
    "roles": {
      "facecam": { "path": "<facecam-device-path>" }
    }
  },
  "private_terms": []
}
