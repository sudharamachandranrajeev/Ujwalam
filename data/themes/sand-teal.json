{
  "$schema": "./theme.schema.json",
  "id": "sand-teal",
  "name": "Sand and Teal",
  "topic": "Warm sand surfaces that look pressed out of one sheet: raised cards and buttons, sunken fields, one deep teal for the main action.",
  "version": 1,
  "dark": false,
  "colors": {
    "bg": "#ebe3d7",
    "panel": "#f2ebe1",
    "field": "#e4dacb",
    "border": "#d3c6b3",
    "text": "#1e2a2a",
    "muted": "#55524b",
    "accent": "#0f5257",
    "accentHi": "#0b4044",
    "danger": "#a8261d",
    "ok": "#25693f",
    "onAccent": "#ffffff",
    "disabled": "#a0978a"
  },
  "gradients": {
    "window": {
      "from": "#eee7dc",
      "to": "#e6ddd0",
      "angle": 90
    },
    "accent": {
      "from": "#14646a",
      "to": "#0d4a4e",
      "angle": 90
    },
    "panel": {
      "from": "#f5efe6",
      "to": "#ece4d8",
      "angle": 90
    },
    "control": {
      "from": "#f4eee5",
      "to": "#e2d8c9",
      "angle": 90
    }
  },
  "typography": {
    "family": "Segoe UI",
    "fallbacks": [
      "Segoe UI Variable Text"
    ],
    "baseSize": 10,
    "captionSize": 8,
    "titleSize": 16,
    "headingWeight": 700,
    "letterSpacing": 0,
    "captionLetterSpacing": 0.8,
    "captionCaps": true
  },
  "geometry": {
    "radius": {
      "small": 8,
      "medium": 12,
      "large": 20
    },
    "spacing": {
      "small": 4,
      "medium": 8,
      "large": 16
    },
    "borderWidth": 1,
    "controlHeight": 20,
    "roundControl": 54,
    "controlPadding": {
      "y": 6,
      "x": 16
    }
  },
  "depth": {
    "card": {
      "shadow": {
        "blur": 18,
        "offsetX": 4,
        "offsetY": 6,
        "color": "#9c8a70",
        "opacity": 0.38
      },
      "glow": {
        "blur": 12,
        "color": "#ffffff",
        "opacity": 0.5,
        "when": "always"
      }
    },
    "button": {},
    "primaryButton": {
      "shadow": {
        "blur": 12,
        "offsetX": 2,
        "offsetY": 4,
        "color": "#0b3c40",
        "opacity": 0.35
      }
    },
    "roundControl": {
      "shadow": {
        "blur": 12,
        "offsetX": 3,
        "offsetY": 4,
        "color": "#9c8a70",
        "opacity": 0.45
      },
      "extrusion": {
        "depth": 2,
        "color": "#c3b49e",
        "color2": "#efe7dc"
      }
    },
    "toast": {
      "shadow": {
        "blur": 22,
        "offsetX": 4,
        "offsetY": 7,
        "color": "#7d6c55",
        "opacity": 0.35
      }
    },
    "menu": {
      "shadow": {
        "blur": 18,
        "offsetX": 3,
        "offsetY": 5,
        "color": "#7d6c55",
        "opacity": 0.32
      }
    },
    "taskPanel": {
      "shadow": {
        "blur": 22,
        "offsetX": 4,
        "offsetY": 7,
        "color": "#7d6c55",
        "opacity": 0.32
      }
    }
  },
  "motion": {
    "fastMs": 130,
    "normalMs": 200,
    "slowMs": 300,
    "easing": "inOutCubic",
    "hoverLift": 1,
    "pressSink": 2
  },
  "background": {
    "kind": "gradient",
    "pattern": "none",
    "patternColor": "#000000",
    "patternOpacity": 0,
    "patternSpacing": 24
  },
  "icons": {
    "stroke": 2
  }
}
