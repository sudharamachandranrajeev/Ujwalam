{
  "$schema": "./theme.schema.json",
  "id": "sand-teal",
  "name": "Sand and Teal",
  "topic": "Warm sand surfaces that look pressed out of one sheet: raised cards and buttons, sunken fields, one deep teal for the main action.",
  "version": 1,
  "dark": false,
  "colors": {
    "bg": "#ebe3d7",
    "panel": "#f2ebe1",
    "field": "#e4dacb",
    "border": "#d3c6b3",
    "text": "#1e2a2a",
    "muted": "#55524b",
    "accent": "#0f5257",
    "accentHi": "#0b4044",
    "danger": "#a8261d",
    "ok": "#25693f",
    "onAccent": "#ffffff",
    "disabled": "#a0978a"
  },
  "gradients": {
    "window": {
      "from": "#eee7dc",
      "to": "#e6ddd0",
      "angle": 90
    },
    "accent": {
      "from": "#14646a",
      "to": "#0d4a4e",
      "angle": 90
    },
    "panel": {
      "from": "#f5efe6",
      "to": "#ece4d8",
      "angle": 90
    },
    "control": {
      "from": "#f4eee5",
      "to": "#e2d8c9",
      "angle": 90
    }
  },
  "typography": {
    "family": "Inter",
    "fallbacks": [
      "Segoe UI"
    ],
    "baseSize": 10,
    "captionSize": 8,
    "titleSize": 16,
    "headingWeight": 700,
    "letterSpacing": 0,
    "captionLetterSpacing": 0.8,
    "captionCaps": true,
    "buttonCaps": false,
    "tabCaps": false,
    "headingCaps": true,
    "scale": {
      "h1": 16,
      "h2": 12,
      "subtitle": 10,
      "body": 10,
      "caption": 8,
      "button": 10
    }
  },
  "geometry": {
    "radius": {
      "small": 6,
      "medium": 12,
      "large": 16
    },
    "spacing": {
      "small": 4,
      "medium": 8,
      "large": 16
    },
    "borderWidth": 1,
    "controlHeight": 20,
    "roundControl": 54,
    "controlPadding": {
      "y": 6,
      "x": 16
    }
  },
  "depth": {
    "card": {
      "shadow": {
        "blur": 18,
        "offsetX": 6,
        "offsetY": 6,
        "color": "#9c8a70",
        "opacity": 0.45
      },
      "highlight": {
        "blur": 16,
        "offsetX": -6,
        "offsetY": -6,
        "color": "#ffffff",
        "opacity": 0.85
      }
    },
    "button": {
      "shadow": {
        "blur": 10,
        "offsetX": 3,
        "offsetY": 3,
        "color": "#9c8a70",
        "opacity": 0.45
      },
      "highlight": {
        "blur": 10,
        "offsetX": -3,
        "offsetY": -3,
        "color": "#ffffff",
        "opacity": 0.8
      },
      "inset": {
        "blur": 8,
        "offsetX": 2,
        "offsetY": 2,
        "color": "#8a7658",
        "opacity": 0.5,
        "when": "pressed"
      }
    },
    "primaryButton": {
      "shadow": {
        "blur": 12,
        "offsetX": 2,
        "offsetY": 4,
        "color": "#0b3c40",
        "opacity": 0.35
      },
      "highlight": {
        "blur": 8,
        "offsetX": -2,
        "offsetY": -2,
        "color": "#ffffff",
        "opacity": 0.6
      },
      "inset": {
        "blur": 8,
        "offsetX": 2,
        "offsetY": 2,
        "color": "#06282b",
        "opacity": 0.5,
        "when": "pressed"
      }
    },
    "roundControl": {
      "shadow": {
        "blur": 12,
        "offsetX": 3,
        "offsetY": 4,
        "color": "#9c8a70",
        "opacity": 0.45
      },
      "highlight": {
        "blur": 10,
        "offsetX": -3,
        "offsetY": -3,
        "color": "#ffffff",
        "opacity": 0.8
      },
      "extrusion": {
        "depth": 2,
        "color": "#c3b49e",
        "color2": "#efe7dc"
      }
    },
    "toast": {
      "shadow": {
        "blur": 20,
        "offsetX": 5,
        "offsetY": 6,
        "color": "#9c8a70",
        "opacity": 0.4
      },
      "highlight": {
        "blur": 14,
        "offsetX": -5,
        "offsetY": -5,
        "color": "#ffffff",
        "opacity": 0.8
      }
    },
    "menu": {
      "shadow": {
        "blur": 16,
        "offsetX": 4,
        "offsetY": 5,
        "color": "#9c8a70",
        "opacity": 0.4
      },
      "highlight": {
        "blur": 12,
        "offsetX": -4,
        "offsetY": -4,
        "color": "#ffffff",
        "opacity": 0.7
      }
    },
    "taskPanel": {
      "shadow": {
        "blur": 20,
        "offsetX": 5,
        "offsetY": 6,
        "color": "#9c8a70",
        "opacity": 0.38
      },
      "highlight": {
        "blur": 14,
        "offsetX": -5,
        "offsetY": -5,
        "color": "#ffffff",
        "opacity": 0.8
      }
    }
  },
  "motion": {
    "fastMs": 130,
    "normalMs": 200,
    "slowMs": 300,
    "easing": "inOutCubic",
    "hoverLift": 1,
    "pressSink": 2
  },
  "background": {
    "kind": "gradient",
    "pattern": "none",
    "patternColor": "#000000",
    "patternOpacity": 0,
    "patternSpacing": 24
  },
  "icons": {
    "stroke": 2
  },
  "components": {
    "button": {
      "shape": "pill",
      "style": "neumorph",
      "caps": false
    },
    "tabs": "segmented",
    "input": "inset",
    "focus": "ring",
    "switch": "labelled",
    "slider": {
      "track": "thin",
      "handle": "round",
      "valueBubble": true
    },
    "sectionHeader": "caps",
    "card": "neumorph",
    "list": "plates",
    "chip": "pill",
    "density": "airy"
  }
}
