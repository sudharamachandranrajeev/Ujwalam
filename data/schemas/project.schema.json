{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ujwalam.local/schema/project.schema.json",
  "title": "Ujwalam project v1",
  "description": "Structure only. Layer type \"duplicate\" (source {layer: <layer id>}) is a second scene item on the SAME libobs source as the target layer: the host creates no new source (no second device open, no second browser, no second decoder), only another item with its own per-canvas placement. The target must be an existing non-duplicate layer (any scene); a duplicate of a duplicate and cycles are rejected. A duplicate has no audio of its own; the target's audio source is the only one. Cross-references (device, layer, track, canvas ids exist; ids unique) are checked by services/project/validate.mjs. Outputs are references to output-config rungs and sinks by id, never encoder settings. Files are path references (base + relative path), never absolute paths.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "name", "canvases", "devices", "scenes", "audio", "outputs", "overlays"],
  "properties": {
    "version": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "name": { "$ref": "#/$defs/label" },
    "activeScene": { "$ref": "#/$defs/id" },
    "origin": { "$ref": "#/$defs/origin" },
    "canvases": {
      "type": "array", "minItems": 1, "maxItems": 2,
      "items": { "$ref": "#/$defs/canvas" }
    },
    "devices": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/device" } },
    "scenes": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/scene" } },
    "audio": { "$ref": "#/$defs/audio" },
    "outputs": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/outputRef" } },
    "overlays": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/overlay" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
    "label": { "type": "string", "minLength": 1, "maxLength": 120 },
    "canvasId": { "enum": ["h", "v"] },
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$" },
    "origin": {
      "type": "object", "additionalProperties": false, "required": ["importer", "id"],
      "properties": {
        "importer": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
        "id": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "pathRef": {
      "type": "object", "additionalProperties": false, "required": ["base", "rel"],
      "properties": {
        "base": { "enum": ["data", "media", "overlays", "profile"] },
        "rel": { "type": "string", "minLength": 1, "maxLength": 260 }
      }
    },
    "canvas": {
      "type": "object", "additionalProperties": false, "required": ["id", "width", "height", "fps"],
      "properties": {
        "id": { "$ref": "#/$defs/canvasId" },
        "width": { "type": "integer", "minimum": 16, "maximum": 8192 },
        "height": { "type": "integer", "minimum": 16, "maximum": 8192 },
        "fps": { "type": "integer", "minimum": 1, "maximum": 240 },
        "transition": {
          "type": "object", "additionalProperties": false, "required": ["type", "durationMs"],
          "properties": {
            "type": { "enum": ["cut", "fade", "stinger"] },
            "durationMs": { "type": "integer", "minimum": 0, "maximum": 10000 },
            "file": { "$ref": "#/$defs/pathRef", "$comment": "stinger only (D242): the video played over the switch" },
            "pointMs": { "type": "integer", "minimum": 0, "maximum": 10000, "$comment": "stinger only: when the scene changes under it" },
            "audio": { "type": "boolean", "$comment": "stinger only (D244): its own sound in the canvas mix; absent = true" },
            "easing": { "type": "string", "pattern": "^[a-z]+(-[a-z]+)*$", "$comment": "fade only (D327 TR1): an id from data/transitions/easing.json; absent = linear" },
            "mirror": { "type": "boolean", "$comment": "D327 TR1, portrait canvas only: true = use the main canvas transition; the own fields stay for when it is off" }
          },
          "if": { "properties": { "type": { "const": "stinger" } } },
          "then": { "properties": { "file": true, "pointMs": true, "easing": false }, "required": ["file", "pointMs"] },
          "else": { "properties": { "file": false, "pointMs": false, "audio": false } }
        }
      }
    },
    "device": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "name", "match"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["capture-card", "camera", "microphone", "audio-output"] },
        "name": { "$ref": "#/$defs/label" },
        "match": {
          "type": "object", "additionalProperties": false, "minProperties": 1,
          "properties": {
            "deviceId": { "type": "string", "minLength": 1, "maxLength": 512 },
            "directShowId": { "type": "string", "minLength": 1, "maxLength": 512 },
            "name": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        },
        "format": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "width": { "type": "integer", "minimum": 16, "maximum": 8192 },
            "height": { "type": "integer", "minimum": 16, "maximum": 8192 },
            "fps": { "type": "integer", "minimum": 1, "maximum": 240 }
          }
        },
        "origin": { "$ref": "#/$defs/origin" }
      }
    },
    "scene": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "layers"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/label" },
        "layers": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/layer" } },
        "origin": { "$ref": "#/$defs/origin" }
      }
    },
    "placement": {
      "type": "object", "additionalProperties": false, "required": ["visible", "x", "y", "width", "height"],
      "properties": {
        "visible": { "type": "boolean" },
        "x": { "type": "number", "minimum": -16384, "maximum": 16384 },
        "y": { "type": "number", "minimum": -16384, "maximum": 16384 },
        "width": { "type": "number", "minimum": 0, "maximum": 16384 },
        "height": { "type": "number", "minimum": 0, "maximum": 16384 },
        "rotation": { "type": "number", "minimum": -360, "maximum": 360 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "crop": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "left": { "type": "number", "minimum": 0 }, "top": { "type": "number", "minimum": 0 },
            "right": { "type": "number", "minimum": 0 }, "bottom": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "effect": {
      "$comment": "Per-layer visual effect, applied in list order to the layer's own copy of its source (a duplicate's effects never reach the original). blur: Gaussian, sigma = strength * 0.5 source pixels (after placement crop). rounded: corner radius in source pixels (after placement crop), transparent outside. chromaKey (D246): pixels near color become transparent (OBS chroma key: similarity and smoothness 1..1000, OBS defaults 400 and 80). shadow and glow (D257): a blurred copy of the layer's alpha in one colour under the layer, reaching past its box; canvas px: size = blur reach (sigma = size / 3), distance = offset, angle = where the light comes from (0 right, 90 above); glow spread 0..1 hardens the edge. color (D258): OBS colour correction, brightness/contrast/saturation -1..1 (0 = unchanged), hue -180..180 degrees. toner (D258): five colours picked by luma (shadows 0, darktones 0.25, midtones 0.5, brights 0.75, highlights 1), mixed with the original by amount. cornerPin (D259): the layer is drawn into the quad of its four corners, each 0..1 of the layer's frame (y down); outside the quad is transparent. blinds (D262): venetian blinds, the first completion 0..1 share of every slat hidden; slats stacked along angle (degrees, y down), width 1..100 % of the layer's larger side, feather 0..100 source px. D291: sharpen (OBS sharpness 0..1); vignette (colour mixed in towards the edges: amount, size = where it starts 0 centre..1 corner, softness); grain (zero-mean noise, size 1..10 source px, seeded per layer, new every frame); pixelate (cell 2..200 source px); posterize (2..32 levels); lut (OBS LUT filter, .cube or 512 x 512 .png, amount); mirror (left-right) and flip (upside down); circleMask (ellipse filling the frame) and roundMask (radius 0..50 % of the shorter side) with feather and borderWidth 0..25 % of the shorter side and a borderColor ring inside the edge; opacity; blendAdd, blendSubtract, blendMultiply, blendScreen, blendLighten, blendDarken (the scene item's blending mode plus opacity; at most one per layer, checked by the validator); gradientMask (fade along angle, 0 = left to right, y down: kept up to start, gone from end, 0..1 of the frame); imageMask (alpha from an image's luma or alpha, invert, feather 0..100 mask px).",
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type", "strength"],
          "properties": { "type": { "const": "blur" }, "strength": { "type": "number", "minimum": 1, "maximum": 100 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "radius"],
          "properties": { "type": { "const": "rounded" }, "radius": { "type": "number", "minimum": 0, "maximum": 500 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "color", "similarity", "smoothness"],
          "properties": { "type": { "const": "chromaKey" }, "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "similarity": { "type": "integer", "minimum": 1, "maximum": 1000 }, "smoothness": { "type": "integer", "minimum": 1, "maximum": 1000 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "color", "opacity", "size", "distance", "angle"],
          "properties": { "type": { "const": "shadow" }, "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "opacity": { "type": "number", "minimum": 0, "maximum": 1 }, "size": { "type": "number", "minimum": 0, "maximum": 200 },
            "distance": { "type": "number", "minimum": 0, "maximum": 200 }, "angle": { "type": "number", "minimum": -360, "maximum": 360 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "color", "opacity", "size", "spread"],
          "properties": { "type": { "const": "glow" }, "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "opacity": { "type": "number", "minimum": 0, "maximum": 1 }, "size": { "type": "number", "minimum": 0, "maximum": 200 },
            "spread": { "type": "number", "minimum": 0, "maximum": 1 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "brightness", "contrast", "saturation", "hue"],
          "properties": { "type": { "const": "color" }, "brightness": { "type": "number", "minimum": -1, "maximum": 1 },
            "contrast": { "type": "number", "minimum": -1, "maximum": 1 }, "saturation": { "type": "number", "minimum": -1, "maximum": 1 },
            "hue": { "type": "number", "minimum": -180, "maximum": 180 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "shadows", "darktones", "midtones", "brights", "highlights", "amount"],
          "properties": { "type": { "const": "toner" }, "shadows": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }, "darktones": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "midtones": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }, "brights": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }, "highlights": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "amount": { "type": "number", "minimum": 0, "maximum": 1 } } },
        { "type": "object", "additionalProperties": false,
          "required": ["type", "topLeftX", "topLeftY", "topRightX", "topRightY", "bottomRightX", "bottomRightY", "bottomLeftX", "bottomLeftY"],
          "properties": { "type": { "const": "cornerPin" }, "topLeftX": { "type": "number", "minimum": 0, "maximum": 1 }, "topLeftY": { "type": "number", "minimum": 0, "maximum": 1 },
            "topRightX": { "type": "number", "minimum": 0, "maximum": 1 }, "topRightY": { "type": "number", "minimum": 0, "maximum": 1 }, "bottomRightX": { "type": "number", "minimum": 0, "maximum": 1 },
            "bottomRightY": { "type": "number", "minimum": 0, "maximum": 1 }, "bottomLeftX": { "type": "number", "minimum": 0, "maximum": 1 }, "bottomLeftY": { "type": "number", "minimum": 0, "maximum": 1 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "completion", "angle", "width", "feather"],
          "properties": { "type": { "const": "blinds" }, "completion": { "type": "number", "minimum": 0, "maximum": 1 }, "angle": { "type": "number", "minimum": -360, "maximum": 360 },
            "width": { "type": "number", "minimum": 1, "maximum": 100 }, "feather": { "type": "number", "minimum": 0, "maximum": 100 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "amount"],
          "properties": { "type": { "const": "sharpen" }, "amount": { "type": "number", "minimum": 0, "maximum": 1 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "amount", "size", "softness", "color"],
          "properties": { "type": { "const": "vignette" }, "amount": { "type": "number", "minimum": 0, "maximum": 1 }, "size": { "type": "number", "minimum": 0, "maximum": 1 },
            "softness": { "type": "number", "minimum": 0, "maximum": 1 }, "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "amount", "size"],
          "properties": { "type": { "const": "grain" }, "amount": { "type": "number", "minimum": 0, "maximum": 1 }, "size": { "type": "number", "minimum": 1, "maximum": 10 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "size"],
          "properties": { "type": { "const": "pixelate" }, "size": { "type": "number", "minimum": 2, "maximum": 200 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "levels"],
          "properties": { "type": { "const": "posterize" }, "levels": { "type": "integer", "minimum": 2, "maximum": 32 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "file", "amount"],
          "properties": { "type": { "const": "lut" }, "file": { "$ref": "#/$defs/pathRef" }, "amount": { "type": "number", "minimum": 0, "maximum": 1 } } },
        { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "enum": ["mirror", "flip"] } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "feather", "borderWidth", "borderColor"],
          "properties": { "type": { "const": "circleMask" }, "feather": { "type": "number", "minimum": 0, "maximum": 25 },
            "borderWidth": { "type": "number", "minimum": 0, "maximum": 25 }, "borderColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "radius", "feather", "borderWidth", "borderColor"],
          "properties": { "type": { "const": "roundMask" }, "radius": { "type": "number", "minimum": 0, "maximum": 50 }, "feather": { "type": "number", "minimum": 0, "maximum": 25 },
            "borderWidth": { "type": "number", "minimum": 0, "maximum": 25 }, "borderColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "opacity"],
          "properties": { "type": { "enum": ["opacity", "blendAdd", "blendSubtract", "blendMultiply", "blendScreen", "blendLighten", "blendDarken"] },
            "opacity": { "type": "number", "minimum": 0, "maximum": 1 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "angle", "start", "end"],
          "properties": { "type": { "const": "gradientMask" }, "angle": { "type": "number", "minimum": -360, "maximum": 360 },
            "start": { "type": "number", "minimum": 0, "maximum": 1 }, "end": { "type": "number", "minimum": 0, "maximum": 1 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "file", "channel", "invert", "feather"],
          "properties": { "type": { "const": "imageMask" }, "file": { "$ref": "#/$defs/pathRef" }, "channel": { "enum": ["luma", "alpha"] },
            "invert": { "type": "boolean" }, "feather": { "type": "number", "minimum": 0, "maximum": 100 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "threshold", "feather", "smoothing"],
          "properties": { "type": { "const": "personMask" }, "mode": { "enum": ["remove", "blur", "replace"] },
            "threshold": { "type": "number", "minimum": 0, "maximum": 1 }, "feather": { "type": "number", "minimum": 0, "maximum": 1 },
            "smoothing": { "type": "number", "minimum": 0, "maximum": 0.95 }, "strength": { "type": "number", "minimum": 1, "maximum": 100 },
            "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }, "file": { "$ref": "#/$defs/pathRef" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "zoom", "smoothing", "deadzone"],
          "properties": { "type": { "const": "autoFrame" }, "zoom": { "type": "number", "minimum": 1, "maximum": 4 },
            "smoothing": { "type": "number", "minimum": 0, "maximum": 5 }, "deadzone": { "type": "number", "minimum": 0, "maximum": 0.5 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "file", "anchor", "scale", "offsetX", "offsetY"],
          "properties": { "type": { "const": "faceSticker" }, "file": { "$ref": "#/$defs/pathRef" },
            "anchor": { "enum": ["eyes", "nose", "forehead", "mouth"] }, "scale": { "type": "number", "minimum": 0.1, "maximum": 10 },
            "offsetX": { "type": "number", "minimum": -5, "maximum": 5 }, "offsetY": { "type": "number", "minimum": -5, "maximum": 5 } } }
      ]
    },
    "layer": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "name", "source", "placements"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["capture", "browser", "image", "media", "text", "color", "duplicate"] },
        "name": { "$ref": "#/$defs/label" },
        "visible": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "source": { "type": "object" },
        "placements": {
          "type": "object", "additionalProperties": false, "minProperties": 1,
          "properties": { "h": { "$ref": "#/$defs/placement" }, "v": { "$ref": "#/$defs/placement" } }
        },
        "effects": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/effect" } },
        "origin": { "$ref": "#/$defs/origin" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "capture" } } }, "then": { "properties": { "source": {
          "type": "object", "additionalProperties": false, "required": ["device"],
          "properties": { "device": { "$ref": "#/$defs/id" } } } } } },
        { "if": { "properties": { "type": { "const": "browser" } } }, "then": { "properties": { "source": {
          "type": "object", "additionalProperties": false, "required": ["width", "height"],
          "properties": {
            "overlay": { "$ref": "#/$defs/id" },
            "query": { "type": "string", "maxLength": 1024, "pattern": "^[^?\u0000-\u001f][^\u0000-\u001f]*$" },
            "url": { "type": "string", "pattern": "^https?://", "maxLength": 2048 },
            "width": { "type": "integer", "minimum": 1, "maximum": 8192 },
            "height": { "type": "integer", "minimum": 1, "maximum": 8192 }
          } } } } },
        { "if": { "properties": { "type": { "const": "image" } } }, "then": { "properties": { "source": {
          "type": "object", "additionalProperties": false, "required": ["file"],
          "properties": { "file": { "$ref": "#/$defs/pathRef" } } } } } },
        { "if": { "properties": { "type": { "const": "media" } } }, "then": { "properties": { "source": {
          "type": "object", "additionalProperties": false, "required": ["file"],
          "properties": { "file": { "$ref": "#/$defs/pathRef" }, "loop": { "type": "boolean" } } } } } },
        { "if": { "properties": { "type": { "const": "text" } } }, "then": { "properties": { "source": {
          "type": "object", "additionalProperties": false, "required": ["text"],
          "properties": {
            "text": { "type": "string", "maxLength": 2000 },
            "font": { "type": "string", "maxLength": 120 },
            "size": { "type": "number", "minimum": 1, "maximum": 2000 },
            "color": { "$ref": "#/$defs/color" } } } } } },
        { "if": { "properties": { "type": { "const": "duplicate" } } }, "then": { "properties": { "source": {
          "type": "object", "additionalProperties": false, "required": ["layer"],
          "properties": { "layer": { "$ref": "#/$defs/id" } } } } } },
        { "if": { "properties": { "type": { "const": "color" } } }, "then": { "properties": { "source": {
          "type": "object", "additionalProperties": false, "required": ["color"],
          "properties": { "color": { "$ref": "#/$defs/color" } } } } } }
      ]
    },
    "audio": {
      "type": "object", "additionalProperties": false, "required": ["tracks", "sources"],
      "properties": {
        "tracks": {
          "type": "array", "minItems": 1, "maxItems": 6,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "name"],
            "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/label" } }
          }
        },
        "masterVolumeDb": { "type": "number", "minimum": -100, "maximum": 12 },
        "sources": {
          "type": "array", "maxItems": 256, "$comment": "D245: a Meld session keeps one audio entry per video layer; 64 was too few for a real session",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "name", "volumeDb", "muted", "monitoring", "tracks"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "name": { "$ref": "#/$defs/label" },
              "device": { "$ref": "#/$defs/id" },
              "layer": { "$ref": "#/$defs/id" },
              "volumeDb": { "type": "number", "minimum": -100, "maximum": 12 },
              "muted": { "type": "boolean" },
              "monitoring": { "enum": ["off", "monitor-only", "monitor-and-output"] },
              "tracks": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/id" } },
              "origin": { "$ref": "#/$defs/origin" }
            }
          }
        }
      }
    },
    "outputRef": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "ref", "canvas"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["rung", "sink"] },
        "ref": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$" },
        "canvas": { "$ref": "#/$defs/canvasId" }
      }
    },
    "overlay": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "file"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/label" },
        "file": { "$ref": "#/$defs/pathRef" }
      }
    }
  }
}
