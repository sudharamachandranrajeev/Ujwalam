{
  "name": "ujwalam",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first streaming studio: Meld-style UX, embedded libobs, AI clipping, chat-driven scenes and effects.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "lint": "node tools/lint.mjs",
    "ci": "node tools/ci.mjs",
    "studio": "node services/studio-ui/launch.mjs",
    "alpha": "node services/studio-ui/launch.mjs --alpha",
    "package:alpha": "node tools/package/build-alpha.mjs",
    "diag": "node tools/diag/bundle.mjs",
    "restore": "node tools/restore-local.mjs",
    "build:host": "node app/host/tools/build.mjs",
    "build:studio": "node app/studio/tools/build.mjs",
    "test:host": "node --test --test-timeout=300000 --test-concurrency=2 \"app/host/tests/*.test.mjs\"",
    "bench": "node tools/bench/run.mjs",
    "soak": "node tools/soak/live-soak.mjs",
    "soak:swap": "node tools/soak/swap-soak.mjs",
    "soak:studio-swap": "node tools/soak/studio-swap-soak.mjs",
    "test:studio-swap": "set UJWALAM_STUDIO_SWAP_STREAM=1&& node --test --test-timeout=900000 tests/studio-swap-stream.test.mjs",
    "fx:test": "node tools/fx-test.mjs",
    "validate:registry": "node tools/registry-validate.mjs registry",
    "legacy:verify": "node tools/legacy-verify.mjs",
    "test": "node --test --test-timeout=300000 \"tests/*.test.mjs\" \"tests/outputs/*.test.mjs\"",
    "validate:outputs": "node tools/outputs-validate-presets.mjs",
    "label": "node tools/label/server.mjs",
    "validate:games": "node tools/game-validate.mjs data/games",
    "test:py": "python -I -m unittest discover -s tests/py -t tests/py -v",
    "test:face": ".venv-gpu\\Scripts\\python.exe -I -m unittest discover -s tests/py -t tests/py -p \"test_face*.py\" -v",
    "test:ocr": ".venv\\Scripts\\python.exe -I -m unittest discover -s tests/py -t tests/py -p \"test_g1*.py\" -v",
    "test:capture": "set UJWALAM_CAPTURE_TESTS=1&& python -I -m unittest discover -s tests/py -t tests/py -p \"test_record.py\" -v"
  },
  "devDependencies": {
    "ajv": "8.20.0"
  }
}
